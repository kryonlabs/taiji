#!/bin/rc

wm=lola
if(! ~ $#* 0){
	wm=$1
	shift
}

switch($wm){
case lola
	if(test -x /bin/lola)
		startlola $*
	if not if(test -x /bin/rio)
		startrio $*
	if not {
		echo 'startwm: neither /bin/lola nor /bin/rio was found' >[1=2]
		exit notfound
	}
case rio
	startrio $*
case acme
	if(! test -x /bin/acme){
		echo 'startwm: /bin/acme not found' >[1=2]
		exit notfound
	}
	acme $*
case *
	echo 'usage: startwm [lola|rio|acme] [args...]' >[1=2]
	exit usage
}
