#!/bin/rc

wm=rio
if(! ~ $#* 0){
	wm=$1
	shift
}

switch($wm){
case rio
	if(test -x /bin/rio)
		startrio $*
	if not {
		echo 'startwm: /bin/rio not found' >[1=2]
		exit notfound
	}
case acme
	if(! test -x /bin/acme){
		echo 'startwm: /bin/acme not found' >[1=2]
		exit notfound
	}
	acme $*
case *
	echo 'usage: startwm [rio|acme] [args...]' >[1=2]
	exit usage
}
