#!/bin/rc

wm=lola
if(! ~ $#* 0){
	wm=$1
	shift
}

switch($wm){
case lola
	if(test -x /bin/lola)
		startlola $*
	if not {
		echo 'startwm: /bin/lola not found' >[1=2]
		exit notfound
	}
case acme
	if(! test -x /bin/acme){
		echo 'startwm: /bin/acme not found' >[1=2]
		exit notfound
	}
	acme $*
case *
	echo 'usage: startwm [lola|acme] [args...]' >[1=2]
	exit usage
}
