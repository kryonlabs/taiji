#!/bin/rc
# Windows-2000 style shut down for the q9 VM.
# The disk is a QEMU snapshot and / is served over u9fs, so there is
# nothing to flush: reboot gives a clean fresh boot through the
# boot manager splash and logon screen.

echo
echo '  It is now safe to turn off your computer.'
echo '  (rebooting this q9 VM instead)'
echo
sleep 2
if(! echo reboot >/dev/reboot >[2]$home/lib/q9shut.err){
	echo 'q9shut: reboot write failed' >[1=2]
	cat $home/lib/q9shut.err >[1=2]
	exit failed
}
