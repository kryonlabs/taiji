#!/bin/rc
# Windows-2000 style log out: end the session and return to the logon
# screen. init's console respawn does not replay the login profile, so
# reboot through the boot splash + logon instead (q9 disks are QEMU
# snapshots; nothing to flush).

echo
echo '  Logging out of Plan 9...'
echo
sleep 1
if(! echo reboot >/dev/reboot >[2]$home/lib/q9shut.err){
	echo 'log out: reboot write failed' >[1=2]
	exit failed
}
