#!/bin/rc
if(test -x /bin/q9display)
	exec q9display
echo Control Panel - Display
echo
if(test -r $home/lib/kryon/theme){
	name=`{sed -n 's/^name=//p' $home/lib/kryon/theme}
	mode=`{sed -n 's/^mode=//p' $home/lib/kryon/theme}
	style=`{sed -n 's/^style=//p' $home/lib/kryon/theme}
}
if(~ $#name 0)
	name=Default
if(~ $#mode 0)
	mode=light
if(~ $#style 0)
	style=retro
echo Theme: kryon ($style $name $mode)
echo Resolution: $vgasize
echo Font: `{basename $font}
echo
echo 'Switch live with: echo ''style material'' > /dev/wctl'
echo '                  echo ''palette ocean'' > /dev/wctl'
echo '                  echo ''mode dark'' > /dev/wctl'
echo '                  echo ''theme kryon:material:Default:dark'' > /dev/wctl'
rc -i
