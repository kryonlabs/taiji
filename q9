#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"

state=boot/q9
rundir=cfg/q9
runrc=$rundir/run.rc
seriallog=$state/serial.log
serialsock=$root/$state/serial.sock
monitorsock=$root/$state/monitor.sock
sessionstate=$root/$state/session.vmstate
sessiontmp=$root/$state/session.vmstate.tmp
sessionlock=$root/$state/session.lock
buildlog=$state/build.log
qemulog=$state/qemu.log
socatlog=$state/socat.log
monitorlog=$state/monitor.log

qemu=${QEMU:-qemu-system-x86_64}
image=${Q9_IMAGE:-boot/pxeboot.raw}
textmac=${Q9_MAC:-52:54:00:12:34:57}
guimac=${Q9_GUI_MAC:-52:54:00:12:34:58}
mac=$guimac
mem=${Q9_MEM:-1G}
smp=${Q9_SMP:-1}
boottimeout=${Q9_BOOT_TIMEOUT:-120}
profile=true
textonly=false
autosave=${Q9_AUTOSAVE:-1}
autosavedelay=${Q9_AUTOSAVE_DELAY:-30}
autosaveinterval=${Q9_AUTOSAVE_INTERVAL:-30}
fresh=false
hadsession=false

usage()
{
	status=${1:-1}
	cat >&2 <<EOF
usage: ./q9 [--text] [--mini] [--raw] [--fresh] [--no-autosave] [--smp n] [console|shell|tty|gui]
       ./q9 [--text] [--mini] [--raw] [--smp n] run command
       ./q9 [--mini] [--raw] [--smp n] tty-run command
       ./q9 [--mini] [--raw] [--smp n] acme|rio|lola [args...]

Default mode boots Glenda's normal graphical Plan 9 profile.
Default graphical mode resumes boot/q9/session.vmstate when present and
autosaves that session while it runs, and again on shutdown or Ctrl-C.

Use --text, tty, or shell to boot a clean rc console on QEMU serial stdio.
Use --fresh to ignore the saved graphical session for this run.
Use --no-autosave or Q9_AUTOSAVE=0 to disable session save/resume.
Q9_AUTOSAVE_DELAY and Q9_AUTOSAVE_INTERVAL tune periodic GUI saves.
Use --smp n or Q9_SMP=n to expose n CPUs to QEMU.
Plan 9 MP stays disabled in q9 profiles until the LAPIC clock panic is fixed.
EOF
	exit "$status"
}

mkdir -p "$state" "$rundir"

raw=false
while [ $# -gt 0 ]; do
	case "$1" in
	--gui|-g)
		profile=true
		mac=$guimac
		shift
		;;
	--text|-t)
		profile=false
		mac=$textmac
		shift
		;;
	--mini)
		image=boot/mini.raw
		shift
		;;
	--raw)
		raw=true
		shift
		;;
	--fresh)
		fresh=true
		shift
		;;
	--no-autosave)
		autosave=0
		shift
		;;
	--smp)
		[ $# -ge 2 ] || usage
		case "$2" in
		*[!0-9]*|'')
			echo "q9: --smp needs a positive integer" >&2
			exit 1
			;;
		esac
		if [ "$2" -lt 1 ]; then
			echo "q9: --smp needs a positive integer" >&2
			exit 1
		fi
		smp=$2
		shift 2
		;;
	--help|-h)
		usage 0
		;;
	*)
		break
		;;
	esac
done

mode=console
if [ $# -gt 0 ]; then
	mode=$1
	shift
fi

case "$mode" in
gui)
	mode=console
	profile=true
	mac=$guimac
	;;
shell|text|tty|sh)
	mode=console
	profile=false
	mac=$textmac
	textonly=true
	;;
tty-run)
	mode=run
	profile=false
	mac=$textmac
	textonly=true
	;;
acme|rio|lola)
	set -- "$mode" "$@"
	mode=run
	profile=false
	mac=$textmac
	;;
esac

if [ "$mode" = run ] && [ "$profile" = true ]; then
	profile=false
	mac=$textmac
fi
if [ "$mode" = run ] && [ "$raw" != true ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
	raw=true
fi

build_u9fs()
{
	u9fsbin=sys/src/cmd/unix/u9fs/u9fs
	if [ "${Q9_REBUILD:-0}" != 1 ] && [ -x "$u9fsbin" ]; then
		if make -q -C sys/src/cmd/unix/u9fs >"$buildlog" 2>&1; then
			return
		fi
	fi
	if ! make -C sys/src/cmd/unix/u9fs >"$buildlog" 2>&1; then
		cat "$buildlog" >&2
		exit 1
	fi
}

write_runrc()
{
	cmd=$1
	tmp=$runrc.$$
	{
		printf '#!/bin/rc\n'
		printf 'echo q9: running /cfg/q9/run.rc\n'
		printf '%s\n' "$cmd"
	} >"$tmp"
	mv "$tmp" "$runrc"
}

clear_runrc()
{
	rm -f "$runrc" "$runrc".*
}

cleanup_runtime()
{
	rm -f "$serialsock" "$monitorsock"
	rmdir "$sessionlock" 2>/dev/null || true
}

qemu_autosave()
{
	[ "$autosave" = 1 ] || return 1
	[ "$profile" = true ] || return 1
	[ "$mode" = console ] || return 1
	[ "$raw" != true ] || return 1
	[ "$textonly" != true ] || return 1
	return 0
}

wait_for_socket()
{
	i=0
	while [ "$i" -lt 10 ]; do
		if [ -S "$serialsock" ]; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "q9: timed out waiting for serial socket: $serialsock" >&2
	return 1
}

wait_for_monitor()
{
	i=0
	while [ "$i" -lt 10 ]; do
		if [ -S "$monitorsock" ]; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "q9: timed out waiting for QEMU monitor: $monitorsock" >&2
	return 1
}

hmp()
{
	printf '%s\n' "$1" | socat - "UNIX-CONNECT:$monitorsock" 2>>"$monitorlog"
}

save_session()
{
	i=0
	action=${1:-quit}

	[ "${qemupid:-}" ] || return 0
	kill -0 "$qemupid" 2>/dev/null || return 0
	wait_for_monitor || return 0
	if ! mkdir "$sessionlock" 2>/dev/null; then
		return 0
	fi
	rm -f "$sessiontmp"
	if ! {
		printf 'stop\n'
		printf 'migrate "exec:cat > %s"\n' "$sessiontmp"
	} | socat - "UNIX-CONNECT:$monitorsock" >>"$monitorlog" 2>&1; then
		if [ "$action" = continue ]; then
			hmp 'cont' >/dev/null 2>&1 || true
		fi
		rmdir "$sessionlock" 2>/dev/null || true
		return 0
	fi
	while [ "$i" -lt 60 ]; do
		if hmp 'info migrate' | grep -qi 'completed'; then
			if [ -s "$sessiontmp" ]; then
				mv "$sessiontmp" "$sessionstate"
				echo "q9: saved session: $sessionstate" >&2
			fi
			if [ "$action" = continue ]; then
				hmp 'cont' >/dev/null 2>&1 || true
			else
				hmp 'quit' >/dev/null 2>&1 || true
			fi
			rmdir "$sessionlock" 2>/dev/null || true
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo 'q9: timed out while saving session' >&2
	if [ "$action" = continue ]; then
		hmp 'cont' >/dev/null 2>&1 || true
	fi
	rm -f "$sessiontmp"
	rmdir "$sessionlock" 2>/dev/null || true
}

watch_autosave()
{
	wait_for_monitor || return 0
	i=0
	while kill -0 "$qemupid" 2>/dev/null; do
		if hmp 'info status' | grep -qi 'status: paused'; then
			save_session
			return 0
		fi
		if [ "$i" -ge "$autosavedelay" ]; then
			save_session continue
			i=0
			while [ "$i" -lt "$autosaveinterval" ] && kill -0 "$qemupid" 2>/dev/null; do
				sleep 1
				i=$((i + 1))
			done
			i=$autosavedelay
		else
			sleep 1
			i=$((i + 1))
		fi
	done
	return 0
}

qemu_common()
{
	u9fs="guestfwd=tcp:10.0.2.1:564-cmd:$root/sys/src/cmd/unix/u9fs/u9fs -a none -u ${USER:-none} $root"
	tftp="tftp=$root"
	if qemu_autosave; then
		if [ "$fresh" != true ] && [ -s "$sessionstate" ]; then
			echo "q9: resuming saved GUI session: $sessionstate" >&2
			"$qemu" -m "$mem" -smp "$smp" \
				-drive file="$root/$image",format=raw -snapshot \
				-device "virtio-net-pci,netdev=net0,mac=$mac" \
				-netdev "user,id=net0,$u9fs,$tftp" \
				-monitor "unix:$monitorsock,server=on,wait=off" \
				-display gtk,window-close=on \
				-action shutdown=pause -no-shutdown \
				-incoming "exec:cat $sessionstate" "$@"
		else
			echo 'q9: no saved GUI session; cold booting' >&2
			"$qemu" -m "$mem" -smp "$smp" \
				-drive file="$root/$image",format=raw -snapshot \
				-device "virtio-net-pci,netdev=net0,mac=$mac" \
				-netdev "user,id=net0,$u9fs,$tftp" \
				-monitor "unix:$monitorsock,server=on,wait=off" \
				-display gtk,window-close=on \
				-action shutdown=pause -no-shutdown "$@"
		fi
	else
		"$qemu" -m "$mem" -smp "$smp" \
			-drive file="$root/$image",format=raw -snapshot \
			-device "virtio-net-pci,netdev=net0,mac=$mac" \
			-netdev "user,id=net0,$u9fs,$tftp" "$@"
	fi
}

run_foreground()
{
	build_u9fs
	if [ "$textonly" = true ]; then
		qemu_common -display none -serial stdio
	else
		qemu_common -serial stdio
	fi
}

wait_for_prompt()
{
	if [ "$profile" = true ]; then
		if [ "$hadsession" = true ]; then
			return 0
		fi
		i=0
		while [ "$i" -lt "$boottimeout" ]; do
			if [ -f "$seriallog" ] && grep -q 'q9: gui ready' "$seriallog"; then
				return 0
			fi
			sleep 1
			i=$((i + 1))
		done
		echo "q9: timed out waiting for graphical session; continuing without initial autosave" >&2
		return 0
	fi
	i=0
	while [ "$i" -lt "$boottimeout" ]; do
		if [ -f "$seriallog" ] && grep -q 'term% ' "$seriallog"; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "q9: timed out waiting for Plan 9 prompt; boot log follows" >&2
	tail -80 "$seriallog" >&2 || true
	return 1
}

run_clean()
{
	command -v socat >/dev/null 2>&1 || {
		echo 'q9: socat is required for the clean console; use --raw for direct QEMU stdio' >&2
		exit 1
	}
	if [ ! -t 0 ] || [ ! -t 1 ]; then
		echo 'q9: clean console needs a terminal; use --raw for non-interactive output' >&2
		exit 1
	fi
	build_u9fs
	rm -f "$seriallog" "$serialsock" "$monitorsock" "$monitorlog"
	hadsession=false
	if qemu_autosave && [ "$fresh" != true ] && [ -s "$sessionstate" ]; then
		hadsession=true
	fi
	if [ "$textonly" = true ]; then
		qemu_common \
			-display none \
			-chardev "socket,id=serial0,path=$serialsock,server=on,wait=on" \
			-serial chardev:serial0 \
			-monitor none >"$qemulog" 2>&1 &
	else
		if qemu_autosave; then
			qemu_common \
				-chardev "socket,id=serial0,path=$serialsock,server=on,wait=on" \
				-serial chardev:serial0 >"$qemulog" 2>&1 &
		else
			qemu_common \
				-chardev "socket,id=serial0,path=$serialsock,server=on,wait=on" \
				-serial chardev:serial0 \
				-monitor none >"$qemulog" 2>&1 &
		fi
	fi
	qemupid=$!
	wait_for_socket
	: >"$seriallog"
	socat -u "UNIX-CONNECT:$serialsock" "OPEN:$seriallog,creat,append" 2>"$socatlog" &
	logpid=$!
	if qemu_autosave; then
		if [ "$fresh" != true ] && [ -s "$sessionstate" ]; then
			wait_for_monitor && hmp 'cont' >/dev/null 2>&1 || true
		fi
		watch_autosave &
		watchpid=$!
	else
		watchpid=
	fi
	trap 'if qemu_autosave; then save_session; fi; kill -TERM "${watchpid:-}" "${logpid:-}" "$qemupid" 2>/dev/null || true; wait "${watchpid:-}" "${logpid:-}" 2>/dev/null || true; wait "$qemupid" 2>/dev/null || true; cleanup_runtime; clear_runrc' EXIT HUP INT TERM
	wait_for_prompt
	if qemu_autosave && [ "$hadsession" != true ]; then
		save_session continue
	fi
	kill -TERM "$logpid" 2>/dev/null || true
	wait "$logpid" 2>/dev/null || true
	wait_for_socket
	if [ "$mode" = run ]; then
		sed -n '/q9: running \/cfg\/q9\/run.rc/,$p' "$seriallog" | sed '$s/term% $//'
	fi
	if [ "$profile" != true ]; then
		printf 'term%% '
	fi
	socat -,rawer,echo=0 "UNIX-CONNECT:$serialsock" 2>>"$socatlog"
}

case "$mode" in
console|shell)
	clear_runrc
	if [ "$raw" = true ]; then
		run_foreground
	else
		run_clean
	fi
	;;
run)
	if [ "$profile" = true ]; then
		echo 'q9: --gui boots the normal profile; it cannot be combined with run' >&2
		usage 1
	fi
	[ $# -gt 0 ] || usage
	write_runrc "$*"
	if [ "$raw" = true ]; then
		trap clear_runrc EXIT HUP INT TERM
		run_foreground
	else
		run_clean
	fi
	;;
	*)
		usage 1
	;;
esac
